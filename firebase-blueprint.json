{
  "entities": {
    "CategoryItem": {
      "title": "CategoryItem",
      "description": "Wholesale catalog category with accent color and thumbnail",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "displayName": { "type": "string" },
        "thumbnailUrl": { "type": "string" },
        "accentColorHex": { "type": "string" },
        "sortOrder": { "type": "number" }
      },
      "required": ["id", "displayName"]
    },
    "SubCategory": {
      "title": "SubCategory",
      "description": "Catalog subcategory under a main category",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "categoryId": { "type": "string" },
        "name": { "type": "string" },
        "iconName": { "type": "string" },
        "thumbnailUrl": { "type": "string" },
        "photoCount": { "type": "number" },
        "sortOrder": { "type": "number" }
      },
      "required": ["id", "categoryId", "name"]
    },
    "WholesaleOrder": {
      "title": "WholesaleOrder",
      "description": "Order submitted by mobile application or created by admin",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "orderNumber": { "type": "string" },
        "customerCode": { "type": "string" },
        "shopName": { "type": "string" },
        "cityName": { "type": "string" },
        "mobileNumber": { "type": "string" },
        "items": { "type": "array" },
        "imitationStatus": { "type": "string" },
        "cosmeticsStatus": { "type": "string" },
        "hairStatus": { "type": "string" },
        "overallStatus": { "type": "string" },
        "notes": { "type": "string" },
        "voiceNoteUrl": { "type": "string" },
        "createdAt": { "type": "number" },
        "source": { "type": "string" },
        "salesmanName": { "type": "string" },
        "displayTitle": { "type": "string" },
        "dateFormatted": { "type": "string" }
      },
      "required": ["id", "orderNumber"]
    },
    "Customer": {
      "title": "Customer",
      "description": "Wholesale customer profile",
      "type": "object",
      "properties": {
        "customerCode": { "type": "string" },
        "shopName": { "type": "string" },
        "cityName": { "type": "string" },
        "mobileNumber": { "type": "string" },
        "address": { "type": "string" }
      },
      "required": ["customerCode", "shopName"]
    },
    "Product": {
      "title": "Product",
      "description": "Catalog product item synced with customer app",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "code": { "type": "string" },
        "categoryId": { "type": "string" },
        "subcategoryId": { "type": "string" },
        "variants": { "type": "array" },
        "minQty": { "type": "number" },
        "imageUrl": { "type": "string" },
        "thumbnailUrl": { "type": "string" },
        "videoUrl": { "type": "string" },
        "isVisible": { "type": "boolean" },
        "status": { "type": "string" },
        "orderIndex": { "type": "number" }
      },
      "required": ["code", "categoryId", "subcategoryId"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": "Product",
      "description": "Unified catalog products collection"
    },
    "/categories/{categoryId}": {
      "schema": "CategoryItem",
      "description": "Wholesale main categories"
    },
    "/subCategories/{subCategoryId}": {
      "schema": "SubCategory",
      "description": "Wholesale subcategories"
    },
    "/orders/{orderId}": {
      "schema": "WholesaleOrder",
      "description": "Wholesale orders from mobile app and admin"
    },
    "/customers/{customerId}": {
      "schema": "Customer",
      "description": "Registered wholesale customers"
    }
  }
}
